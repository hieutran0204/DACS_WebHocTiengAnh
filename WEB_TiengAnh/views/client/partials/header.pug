head
  link(rel="stylesheet" href="/css/header.css")
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css")
  link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
  link(href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet")
  script(src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js")
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js")

body
  header.header
    div.container.d-flex.align-items-center
      // Logo
      div.logo-container
        a(href="/")
          img(src="/images/logo/67133d06115ea.png" alt="Logo" style="height: 40px;")
      
      // Menu
      nav.nav-menu.mx-auto
        a.nav-link(href="/news") 
          i.fas.fa-newspaper.mr-2
          | Tin tức tiếng Anh
        a.nav-link(href="#") 
          i.fas.fa-file-alt.mr-2
          | Bài mẫu TOEIC
        .nav-item.dropdown 
          a.nav-link.dropdown-toggle(href="#", id="navbarDropdown", role="button", data-toggle="dropdown", aria-haspopup="true", aria-expanded="false")
            i.fas.fa-clipboard-check.mr-2
            | Test Online
          .dropdown-menu(aria-labelledby="navbarDropdown")
            a.dropdown-item(href="/testtoeic/reading-list") Test TOEIC Reading
            a.dropdown-item(href="/testtoeic/listening-list") Test TOEIC Listening
            a.dropdown-item(href="/testtoeic/writing-list") Test TOEIC Writing
        .nav-item.dropdown 
          a.nav-link.dropdown-toggle(href="#", id="navbarDropdown", role="button", data-toggle="dropdown", aria-haspopup="true", aria-expanded="false")
            i.fas.fa-dumbbell.mr-2
            | Luyện Tập
          .dropdown-menu(aria-labelledby="navbarDropdown")
            a.dropdown-item(href="/speaking") Luyện nói
            a.dropdown-item(href="/transcription") Luyện nghe viết
        .nav-item.dropdown 
          a.nav-link.dropdown-toggle(href="#", id="navbarDropdown", role="button", data-toggle="dropdown", aria-haspopup="true", aria-expanded="false")
            i.fas.fa-gamepad.mr-2
            | Trò chơi
          .dropdown-menu(aria-labelledby="navbarDropdown")
            a.dropdown-item(href="/wordgame") Trò chơi từ vựng
            a.dropdown-item(href="/hidden-word") Đoán từ ẩn
            a.dropdown-item(href="/toeic-vocabulary") Từ vựng TOEIC

      // Account section
      div.account-container
        if !isLoggedIn
          a.btn.btn-login(href="/auth/login") 
            i.fas.fa-sign-in-alt.mr-2
            | Đăng nhập
          a.btn.btn-register(href="/auth/register") 
            i.fas.fa-user-plus.mr-2
            | Đăng ký
        else
          div.dropdown
            button.btn.btn-account.dropdown-toggle(type="button" id="accountDropdown" data-toggle="dropdown" aria-expanded="false")
              i.fas.fa-user-circle.mr-2
              | #{userName || 'User Name'}
            ul.dropdown-menu.dropdown-menu-right(aria-labelledby="accountDropdown")
              li
                a.dropdown-item(href="/profile") 
                  i.fas.fa-user.mr-2
                  | Hồ sơ
              li
                a.dropdown-item(href="/settings") 
                  i.fas.fa-cog.mr-2
                  | Cài đặt
              li
                hr
              li
                a.dropdown-item(href="/logout") 
                  i.fas.fa-sign-out-alt.mr-2
                  | Đăng xuất