extends ../layouts/default

block head
  title Danh sách đề thi Reading TOEIC
  link(rel="stylesheet", href="/client/css/exam-reading-list.css")

block content
  .container.mt-5
    h1.text-center.mb-4 Danh sách Đề thi Reading TOEIC

    if error && error.length
      .alert.alert-danger.text-center #{error}
    if !examParts.length
      .alert.alert-info.text-center Không có đề thi Reading nào được public.
    else
      .row
        each examPart in examParts
          .col-md-4.mb-4
            .card.h-100
              .card-header.bg-primary.text-white
                h5.mb-0 Đề #{examPart._id}
              .card-body
                p
                  strong Part: 
                  | #{examPart.part ? examPart.part.join(', ') : 'N/A'}
                p
                  strong Độ khó: 
                  | #{difficultyMap[examPart.difficulty] || 'Chưa xác định'}
                p
                  strong Người tạo: 
                  | #{examPart.createdBy ? examPart.createdBy.username : 'Không xác định'}
                p
                  strong Ngày tạo: 
                  | #{new Date(examPart.createdAt).toLocaleDateString()}
              .card-footer
                a.btn.btn-primary.w-100(href=`/toeic/reading/${examPart._id}`) Làm bài

      // Phân trang
      if total > limit
        nav(aria-label='Page navigation')
          ul.pagination.justify-content-center.mt-4
            if page > 1
              li.page-item
                a.page-link(href=`?page=${page - 1}&limit=${limit}`) Trang trước
            - for (let i = 1; i <= Math.ceil(total / limit); i++)
              li.page-item(class=i === page ? 'active' : '')
                a.page-link(href=`?page=${i}&limit=${limit}`) #{i}
            if page < Math.ceil(total / limit)
              li.page-item
                a.page-link(href=`?page=${page + 1}&limit=${limit}`) Trang sau