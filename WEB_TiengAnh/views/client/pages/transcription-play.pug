extends ../layouts/default
block head
  link(rel="stylesheet", href="/client/css/transcription-play.css")
block content
  .transcription-practice-container
    if error
      .alert.alert-danger.text-center #{error}
    else if !item
      .alert.alert-info.text-center Không tìm thấy bài transcription.
    else
      .header-section
        h1.title #{item.title}
        a.back-button(href="/transcription") ← Quay lại danh sách

      .audio-player-container
        if item.imagePath
          .image-container.mb-4
            img(src=item.imagePath alt="Transcription Image")
        if item.audioPath
          audio#transcriptionAudio(controls src=item.audioPath controlsList="nodownload")
            | Your browser does not support the audio element.
          .audio-controls
            button.play-button(type="button") ▶ Play
            button.pause-button(type="button") ⏸ Pause
            span.current-time 0:00
            span.duration-time / 0:00
        else
          p.text-warning.text-center Không có audio để nghe.

      .transcription-box
        form#transcriptionForm(action=`/transcription/${item._id}` method="POST")
          label(for="userText") Nhập transcript mà bạn nghe được:
          textarea#userText(name="userText" rows="8" placeholder="Nhập transcript tại đây..." required)= result ? result.userInput : ''
          button.compare-button(type="submit")
            span.button-text Kiểm tra độ chính xác
            span.button-loading.d-none
              i.fas.fa-spinner.fa-spin

        if result
          .result-container
            h3.result-title Kết quả của bạn
            .accuracy-meter
              .accuracy-fill(style=`width: ${result.percent}%`)
              .accuracy-text #{result.percent}% Độ chính xác
            if result.percent >= 80
              .feedback.good Chúc mừng! Bạn đã hiểu hầu hết nội dung.
            else if result.percent >= 50
              .feedback.average Không tệ! Hãy tiếp tục luyện tập để cải thiện.
            else
              .feedback.poor Hãy nghe lại và chú ý đến các chi tiết nhỏ nhé.

            .comparison-table.mt-4
              h4 So sánh chi tiết
              if result.comparison && result.comparison.length
                table.table.table-bordered
                  thead
                    tr
                      th Từ của bạn
                      th Từ gốc
                      th Kết quả
                  tbody
                    each comp in result.comparison
                      tr(class=comp.isCorrect ? 'table-success' : 'table-danger')
                        td #{comp.userWord || '-'}
                        td #{comp.originalWord || '-'}
                        td #{comp.isCorrect ? 'Đúng' : 'Sai'}
              else
                p.text-warning Không có dữ liệu so sánh.

            .original-transcript.mt-4
              h4 Transcript gốc:
              .transcript-content #{result.original}

    script.
      const audio = document.getElementById('transcriptionAudio');
      const playButton = document.querySelector('.play-button');
      const pauseButton = document.querySelector('.pause-button');
      const currentTime = document.querySelector('.current-time');
      const durationTime = document.querySelector('.duration-time');
      const form = document.getElementById('transcriptionForm');
      const compareButton = document.querySelector('.compare-button');
      const buttonText = document.querySelector('.button-text');
      const buttonLoading = document.querySelector('.button-loading');

      console.log('Audio element:', audio); // Debug

      // Format thời gian từ giây sang MM:SS
      function formatTime(seconds) {
        if (isNaN(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }

      // Cập nhật thời gian hiện tại
      if (audio) {
        audio.addEventListener('timeupdate', () => {
          currentTime.textContent = formatTime(audio.currentTime);
        });

        // Cập nhật thời lượng khi metadata được tải
        audio.addEventListener('loadedmetadata', () => {
          durationTime.textContent = `/ ${formatTime(audio.duration)}`;
        });

        audio.addEventListener('error', (e) => {
          console.error('Lỗi tải audio:', e);
          currentTime.textContent = 'Lỗi';
          durationTime.textContent = '';
        });

        // Điều khiển play/pause
        playButton.addEventListener('click', () => {
          audio.play().catch(err => console.error('Lỗi phát audio:', err));
        });

        pauseButton.addEventListener('click', () => {
          audio.pause();
        });
      } else {
        console.warn('Không tìm thấy audio element');
      }

      // Hiệu ứng loading khi gửi form
      if (form) {
        form.addEventListener('submit', () => {
          compareButton.disabled = true;
          buttonText.classList.add('d-none');
          buttonLoading.classList.remove('d-none');
        });
      }

    